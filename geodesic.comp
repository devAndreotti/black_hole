#version 430
layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0, rgba8) writeonly uniform image2D outImage;
// Running average of jittered samples (temporal AA); valid while the view is static
layout(binding = 1, rgba32f) uniform image2D accumImage;
layout(std140, binding = 1) uniform Camera {
    vec3 camPos;     float _pad0;
    vec3 camRight;   float _pad1;
    vec3 camUp;      float _pad2;
    vec3 camForward; float _pad3;
    float tanHalfFov;
    float aspect;
    int moving;
    int renderWidth;
    int renderHeight;
    int steps;
    float dLambda;
    float kerrSpin;   // DIMENSIONLESS spin a* in [0,1]; a = a*·(r_s/2)
    vec2 jitter;      // sub-pixel ray offset (in pixels) for temporal AA
    int sampleIndex;  // 0 = fresh frame (no blend), N>0 = Nth accumulation pass
    int showBeam;
    float time;       // elapsed seconds, for Keplerian disk animation
    int diskAnim;     // 1 = animate disk material (Keplerian rotation)
} cam;

layout(std140, binding = 2) uniform Disk {
    float disk_r1;
    float disk_r2;
    float disk_num;
    float thickness;
    vec4 diskColor_tint;
};

layout(std140, binding = 3) uniform Objects {
    int numObjects;
    vec4 objPosRadius[16];
    vec4 objColor[16];
    float  mass[16];
};

const float SagA_rs = 1.269e10;     // Schwarzschild radius in SI metres
const double ESCAPE_R = 5e11;

// ── Units ────────────────────────────────────────────────────────────────────
// Integration runs in NON-DIMENSIONAL units (length in r_s, so r_s = 1). At SI
// scale r ~ 1e11 m the Kerr effective-potential terms Σ²,P² reach ~r⁴ ~ 1e44 and
// overflow float32 → NaN; in r_s units r̃ ~ 1..40 stays safe. Both the Kerr and
// the legacy Schwarzschild integrators run scaled. ray.r is SCALED; ray.x/y/z
// are kept in SI metres for the intersection tests.
const float U = SagA_rs;

vec4 objectColor = vec4(0.0);
vec3 hitCenter = vec3(0.0);

// Kerr spin in scaled units: ã = a/r_s = a*·(1/2). a=0 → Schwarzschild.
float kerrA() { return cam.kerrSpin * 0.5; }
// Default view (no spin) uses the LEGACY Schwarzschild integrator so its look is
// identical to --legacy (clean shadow, smooth photon ring). Kerr only kicks in
// once the user enables spin (K / --spin), which is an opt-in feature.
bool useKerr() { return kerrA() > 1e-6; }

// ── Coordinate convention ────────────────────────────────────────────────────
// Y-polar spherical: θ from +Y, φ in the XZ plane. Polar axis = Y, so the
// equatorial plane (θ=π/2) is the disk plane (Y=0) and the Kerr spin axis = Y.
//   x = r·sinθ·cosφ,  y = r·cosθ,  z = r·sinθ·sinφ
// ────────────────────────────────────────────────────────────────────────────

struct Ray {
    float x, y, z;          // SI Cartesian (for intersection tests)
    float r;                // SCALED radius (units of r_s)
    float theta, phi;
    float dr, dtheta, dphi; // scaled velocities (dphi: integrated for legacy)
    float E, L, Q;          // conserved: energy, axial Lz, Carter (Q used by Kerr)
};

// dφ/dλ from Kerr conservation (scaled, r_s = 1).
float kerrDphi(float r, float theta, float E, float L, float Q) {
    float a  = kerrA();
    float ct = cos(theta), st = sin(theta);
    float st2 = max(st*st, 4.0e-4);   // floor sin θ ≈ 0.02 → tames the polar axis
    float S = r*r + a*a*ct*ct;
    float D = r*r - r + a*a;
    float P = E*(r*r + a*a) - a*L;
    return (L/st2 - a*E + a*P/D) / S;
}

// ── initRay: shared Y-polar setup, then per-model conserved quantities ───────
Ray initRay(vec3 pos, vec3 dir) {
    Ray ray;
    ray.x = pos.x; ray.y = pos.y; ray.z = pos.z;   // SI
    float rmag = length(pos);
    ray.r = rmag / U;                               // scaled
    ray.theta = acos(pos.y / rmag);
    ray.phi   = atan(pos.z, pos.x);

    float r = ray.r, th = ray.theta;
    float st = sin(th), ct = cos(th);
    float sp = sin(ray.phi), cp = cos(ray.phi);
    float st2 = max(st*st, 4.0e-4);
    float sth = max(st, 0.02);        // clamped sin θ for the φ denominator

    float dx = dir.x, dy = dir.y, dz = dir.z;
    ray.dr     =  st*cp*dx + ct*dy + st*sp*dz;
    ray.dtheta = (ct*cp*dx - st*dy + ct*sp*dz) / r;
    ray.dphi   = (-sp*dx + cp*dz) / (r * sth);
    ray.Q = 0.0;

    if (useKerr()) {
        // Kerr: conserved E, Lz, Q from the null condition (covariant metric, r_s=1)
        float a = kerrA();
        float S = r*r + a*a*ct*ct;
        float D = r*r - r + a*a;
        float gtt = -(1.0 - r/S);
        float grr = S/D;
        float gthth = S;
        float gpp = (r*r + a*a + r*a*a*st2/S) * st2;
        float gtp = -r*a*st2/S;
        float spatial = grr*ray.dr*ray.dr + gthth*ray.dtheta*ray.dtheta + gpp*ray.dphi*ray.dphi;
        float disc = gtp*ray.dphi*gtp*ray.dphi - gtt*spatial;
        disc = max(disc, 0.0);
        float dt = (-gtp*ray.dphi - sqrt(disc)) / gtt;
        ray.E = -(gtt*dt + gtp*ray.dphi);
        ray.L =  (gtp*dt + gpp*ray.dphi);
        float pth = gthth * ray.dtheta;
        ray.Q = pth*pth + ct*ct*(ray.L*ray.L/st2 - a*a*ray.E*ray.E);
    } else {
        // Legacy Schwarzschild (matches --legacy): E = f·(dt/dλ), r_s = 1
        ray.L = ray.r * ray.r * st * ray.dphi;
        float f = 1.0 - 1.0/ray.r;
        float dt_dL = sqrt((ray.dr*ray.dr)/f + ray.r*ray.r*(ray.dtheta*ray.dtheta + st*st*ray.dphi*ray.dphi));
        ray.E = f * dt_dL;
    }
    return ray;
}

// Capture at the outer horizon r₊ = ½(1 + √(1−4a²)) (scaled); = 1 when a=0.
bool intercept(Ray ray) {
    float a = kerrA();
    float rh = 0.5 * (1.0 + sqrt(max(1.0 - 4.0*a*a, 0.0)));
    return ray.r <= rh;
}
bool interceptObject(Ray ray) {
    vec3 P = vec3(ray.x, ray.y, ray.z);
    for (int i = 0; i < numObjects; ++i) {
        vec3 center = objPosRadius[i].xyz;
        float radius = objPosRadius[i].w;
        if (distance(P, center) <= radius) {
            objectColor = objColor[i];
            hitCenter = center;
            return true;
        }
    }
    return false;
}

// ── geodesicRHS: branches between legacy Schwarzschild and Kerr ───────────────
// d1 = (dr, dθ, dφ)/dλ ;  d2 = (d²r, d²θ, d²φ)/dλ²  (d2.z=0 for Kerr: dφ algebraic)
void geodesicRHS(Ray ray, out vec3 d1, out vec3 d2) {
    float r = ray.r, th = ray.theta;
    float dr = ray.dr, dtheta = ray.dtheta;
    float st = sin(th), ct = cos(th);

    if (useKerr()) {
        float a = kerrA();
        float sth = max(st, 0.02);           // clamped sin θ (polar-axis safety)
        float st2 = sth*sth;
        float S = r*r + a*a*ct*ct;
        float D = r*r - r + a*a;
        float P = ray.E*(r*r + a*a) - a*ray.L;
        float LaE = ray.L - a*ray.E;
        float dR  = 4.0*r*ray.E*P - (2.0*r - 1.0)*(LaE*LaE + ray.Q);
        float dTh = 2.0*ct*(ray.L*ray.L/(st2*sth) - a*a*ray.E*ray.E*st);
        float dS  = 2.0*r*dr - 2.0*a*a*ct*st*dtheta;
        float S2  = S*S;
        float pr_acc  = dR/(2.0*S2) - dS*dr/S;
        float pth_acc = dTh/(2.0*S2) - dS*dtheta/S;
        d1 = vec3(dr, dtheta, kerrDphi(r, th, ray.E, ray.L, ray.Q));
        d2 = vec3(pr_acc, pth_acc, 0.0);
    } else {
        // Legacy Schwarzschild (Christoffel), scaled r_s = 1. Identical to --legacy.
        float dphi = ray.dphi;
        float f = 1.0 - 1.0/r;
        float dt_dL = ray.E / f;
        d1 = vec3(dr, dtheta, dphi);
        d2.x = - (1.0 / (2.0 * r*r)) * f * dt_dL * dt_dL
             + (1.0 / (2.0 * r*r * f)) * dr * dr
             + r * (dtheta*dtheta + st*st*dphi*dphi);
        d2.y = -2.0*dr*dtheta/r + st*ct*dphi*dphi;
        d2.z = -2.0*dr*dphi/r - 2.0*ct/max(st, 0.02) * dtheta * dphi;
    }
}

// Single RK4 integrating r, θ, φ, dr, dθ, dφ. For Kerr, d2.z=0 so dφ stays put
// and the φ velocity comes from kerrDphi via d1.z each substep.
void rk4Step(inout Ray ray, float dL) {
    vec3 k1a, k1b, k2a, k2b, k3a, k3b, k4a, k4b;
    Ray tmp;

    geodesicRHS(ray, k1a, k1b);

    tmp = ray;
    tmp.r += 0.5*dL*k1a.x; tmp.theta += 0.5*dL*k1a.y; tmp.phi += 0.5*dL*k1a.z;
    tmp.dr += 0.5*dL*k1b.x; tmp.dtheta += 0.5*dL*k1b.y; tmp.dphi += 0.5*dL*k1b.z;
    geodesicRHS(tmp, k2a, k2b);

    tmp = ray;
    tmp.r += 0.5*dL*k2a.x; tmp.theta += 0.5*dL*k2a.y; tmp.phi += 0.5*dL*k2a.z;
    tmp.dr += 0.5*dL*k2b.x; tmp.dtheta += 0.5*dL*k2b.y; tmp.dphi += 0.5*dL*k2b.z;
    geodesicRHS(tmp, k3a, k3b);

    tmp = ray;
    tmp.r += dL*k3a.x; tmp.theta += dL*k3a.y; tmp.phi += dL*k3a.z;
    tmp.dr += dL*k3b.x; tmp.dtheta += dL*k3b.y; tmp.dphi += dL*k3b.z;
    geodesicRHS(tmp, k4a, k4b);

    ray.r      += dL/6.0 * (k1a.x + 2.0*k2a.x + 2.0*k3a.x + k4a.x);
    ray.theta  += dL/6.0 * (k1a.y + 2.0*k2a.y + 2.0*k3a.y + k4a.y);
    ray.phi    += dL/6.0 * (k1a.z + 2.0*k2a.z + 2.0*k3a.z + k4a.z);
    ray.dr     += dL/6.0 * (k1b.x + 2.0*k2b.x + 2.0*k3b.x + k4b.x);
    ray.dtheta += dL/6.0 * (k1b.y + 2.0*k2b.y + 2.0*k3b.y + k4b.y);
    ray.dphi   += dL/6.0 * (k1b.z + 2.0*k2b.z + 2.0*k3b.z + k4b.z);

    float rs_si = ray.r * U;
    ray.x = rs_si * sin(ray.theta) * cos(ray.phi);
    ray.y = rs_si * cos(ray.theta);
    ray.z = rs_si * sin(ray.theta) * sin(ray.phi);
}
// --- Deep-sky helpers ---
float starHash(vec3 p) {
    p = fract(p * vec3(127.1, 311.7, 74.7));
    p += dot(p, p.yzx + 19.19);
    return fract(p.x * p.y * p.z * 95.13);
}
// Smooth 3D value noise + fBm for the nebula clouds.
float hash13(vec3 p) {
    p = fract(p * 0.1031);
    p += dot(p, p.zyx + 31.32);
    return fract((p.x + p.y) * p.z);
}
float vnoise(vec3 p) {
    vec3 i = floor(p), f = fract(p);
    f = f * f * (3.0 - 2.0 * f);
    float n000 = hash13(i + vec3(0,0,0)), n100 = hash13(i + vec3(1,0,0));
    float n010 = hash13(i + vec3(0,1,0)), n110 = hash13(i + vec3(1,1,0));
    float n001 = hash13(i + vec3(0,0,1)), n101 = hash13(i + vec3(1,0,1));
    float n011 = hash13(i + vec3(0,1,1)), n111 = hash13(i + vec3(1,1,1));
    return mix(mix(mix(n000,n100,f.x), mix(n010,n110,f.x), f.y),
               mix(mix(n001,n101,f.x), mix(n011,n111,f.x), f.y), f.z);
}
float fbm(vec3 p) {
    float v = 0.0, a = 0.5;
    for (int i = 0; i < 4; i++) { v += a * vnoise(p); p *= 2.03; a *= 0.5; }
    return v;
}

// A distinct face-on spiral galaxy sitting in one patch of the sky. Sampled along
// the escape direction like everything else, so it lenses into an Einstein ring
// when it passes behind the BH. Cheap: rays outside its angular patch early-out.
vec3 spiralGalaxy(vec3 d) {
    const vec3 gc = normalize(vec3(-0.97, -0.219, -0.105));   // direction to its centre
    float ca = dot(d, gc);
    if (ca < 0.90) return vec3(0.0);                       // ~26° patch
    vec3 upv = normalize(cross(gc, vec3(0.0, 1.0, 0.0)));
    vec3 vpv = cross(gc, upv);
    vec3 rel = d - gc * ca;                                // ⟂ component
    vec2 q   = vec2(dot(rel, upv), dot(rel, vpv)) * 2.4;   // patch → ~unit disk
    float rho = length(q);
    float phi = atan(q.y, q.x);
    float arm  = cos(2.0*phi - 7.0*log(rho + 0.08));       // 2-arm log spiral
    float arms = smoothstep(0.05, 1.0, 0.5 + 0.5*arm);
    float disk = smoothstep(1.1, 0.04, rho) * (0.20 + 0.80*arms);
    float bulge = exp(-rho*rho*22.0);                      // bright core
    float inten = clamp(disk*1.1 + bulge*1.5, 0.0, 2.2);
    vec3 col = mix(vec3(0.45,0.58,1.0), vec3(1.0,0.92,0.72), clamp(bulge*1.4, 0.0, 1.0));
    col *= 0.80 + 0.20 * vnoise(d * 40.0);                 // dust mottling in the arms
    return col * inten * 0.7;
}

// Procedural deep sky sampled along the (gravitationally bent) escape direction,
// so the galactic band and nebulae lens into arcs / Einstein rings near the BH.
//   • a tilted galactic band: denser stars + a faint glow + a dark dust lane
//   • coloured nebula clouds (fBm), concentrated toward the band
//   • three octaves of stars (the original starfield)
vec3 deepSky(vec3 d) {
    // Galactic pole tilted well off the Y axis so the band crosses the view
    // diagonally (and isn't hidden edge-on in the disk plane).
    const vec3 galN = normalize(vec3(0.62, 0.42, -0.66));
    float lat  = dot(d, galN);                            // 0 = in the galactic plane
    float band = exp(-lat*lat / (2.0 * 0.22*0.22));       // soft band envelope
    float dust = exp(-lat*lat / (2.0 * 0.060*0.060));     // narrow dark dust lane

    // Nebula clouds (fBm), brighter inside the band, tinted across the sky.
    float neb  = fbm(d * 3.5 + 11.0);
    neb        = smoothstep(0.46, 0.92, neb) * (0.30 + 0.70 * band);
    float tsel = fbm(d * 1.7 + 50.0);
    vec3  nebA = vec3(0.65, 0.12, 0.70);   // magenta / violet
    vec3  nebB = vec3(0.10, 0.45, 0.78);   // blue / cyan
    vec3  nebCol = mix(nebA, nebB, smoothstep(0.30, 0.70, tsel)) * neb * 0.85;
    nebCol *= (1.0 - 0.6 * dust);

    // Diffuse galactic glow, cut by the dust lane.
    vec3 glow = vec3(0.16, 0.14, 0.20) * band * (1.0 - 0.75 * dust);

    // Stars: three octaves, denser inside the band, dimmed by the dust lane.
    vec3 stars = vec3(0.0);
    for (int i = 0; i < 3; i++) {
        float scale = float(200 + i * 300);
        vec3  cell  = floor(d * scale);
        float h     = starHash(cell);
        float thresh = 0.994 + float(i) * 0.002 - 0.0035 * band;
        if (h > thresh) {
            float bright = (h - thresh) / (1.0 - thresh);
            float hc     = starHash(cell + vec3(1.0));
            stars += mix(vec3(1.0,0.85,0.70), vec3(0.80,0.90,1.0), hc)
                     * bright * (1.0 - float(i) * 0.25);
        }
    }
    stars *= (1.0 - 0.55 * dust);

    return min(stars + nebCol + glow + spiralGalaxy(d), vec3(1.6));
}
vec3 rayCartesianDir(Ray ray) {
    float st = sin(ray.theta), ct = cos(ray.theta);
    float sp = sin(ray.phi),   cp = cos(ray.phi);
    float dphi = useKerr() ? kerrDphi(ray.r, ray.theta, ray.E, ray.L, ray.Q) : ray.dphi;
    return normalize(vec3(
        ray.dr * st*cp + ray.r * ray.dtheta * ct*cp - ray.r * st * dphi * sp,
        ray.dr * ct    - ray.r * ray.dtheta * st,
        ray.dr * st*sp + ray.r * ray.dtheta * ct*sp + ray.r * st * dphi * cp
    ));
}

// Emissive colour of the accretion disk at an equatorial hit point (cylindrical
// radius dhR, plane coords dhX/dhZ). Includes the radial tint, optional Keplerian
// animation, relativistic Doppler beaming, and gravitational redshift. Evaluated
// at every plane crossing so the lensed secondary image can be composited.
vec3 diskShade(float dhR, float dhX, float dhZ) {
    float r = dhR / disk_r2;
    vec3 diskColor;
    int mode = int(round(diskColor_tint.a));
    if (mode == 2) {
        diskColor = vec3(1.0 - 0.5*r, 0.1*(1.0 - r), 0.1*(1.0 - r));
    } else if (mode == 3) {
        float val = 1.0 - 0.5*r;
        diskColor = vec3(val, val, val + 0.05*(1.0 - r));
    } else {
        diskColor = vec3(1.0, r, 0.2);
    }

    if (cam.diskAnim != 0) {
        float omega   = 0.5 * pow(disk_r2 / max(dhR, 1.0), 1.5);
        float matPhi  = atan(dhZ, dhX) - cam.time * omega;
        float pattern = 0.55 + 0.45 * cos(matPhi * 6.0 + r * 3.14159);
        diskColor    *= pattern;
    }

    // Relativistic Doppler beaming (Keplerian prograde orbit)
    float beta   = clamp(sqrt(SagA_rs / (2.0 * dhR)), 0.0, 0.95);
    vec3  velDir = normalize(vec3(-dhZ, 0.0, dhX));
    vec3  viewDir = normalize(cam.camPos - vec3(dhX, 0.0, dhZ));
    float cosA   = dot(velDir, viewDir);
    float gamma  = 1.0 / sqrt(1.0 - beta * beta);
    float D      = 1.0 / (gamma * (1.0 - beta * cosA));
    diskColor   *= clamp(D*D*D, 0.05, 8.0);
    float shift  = clamp((D - 1.0) * 0.35, -0.3, 0.3);
    diskColor.b  = clamp(diskColor.b + shift * 0.55, 0.0, 1.0);
    diskColor.g  = clamp(diskColor.g + shift * 0.15, 0.0, 1.0);

    // Gravitational redshift (dims + reddens toward the horizon)
    float gr = sqrt(max(1.0 - SagA_rs / dhR, 0.0));
    diskColor   *= clamp(gr*gr*gr, 0.03, 1.0);
    diskColor.g *= gr;
    diskColor.b *= gr*gr;
    return diskColor;
}

// Relativistic polar jet emission at a point (SI Cartesian). Two jets along ±Y
// (the spin axis), powered by the BH spin (Blandford-Znajek) → intensity ∝ spin,
// so they only appear once Kerr spin is enabled. Optically thin, emissive.
vec3 jetEmission(vec3 pos) {
    float spin = cam.kerrSpin;
    if (spin < 0.02) return vec3(0.0);
    float ay = abs(pos.y);
    float h  = ay / SagA_rs;                          // height above the plane, in r_s
    if (h < 0.6 || h > 34.0) return vec3(0.0);
    float jetR = SagA_rs * (0.7 + 0.08 * h);          // widening cone
    float cylR = length(vec2(pos.x, pos.z));
    if (cylR > jetR) return vec3(0.0);
    float radial = 1.0 - cylR / jetR;  radial *= radial;            // bright core
    float heightFade = smoothstep(34.0, 2.0, h) * smoothstep(0.6, 2.5, h);
    float flow  = (cam.diskAnim != 0) ? cam.time * 0.6 : 0.0;       // TAA-safe when off
    float ph    = atan(pos.z, pos.x);
    float helix = 0.58 + 0.42 * sin(ph * 2.0 - h * 1.2 + flow);     // twisting structure
    float dens  = radial * heightFade * helix;
    vec3  col   = mix(vec3(0.55,0.80,1.0), vec3(0.28,0.50,1.0), clamp(h/22.0, 0.0, 1.0));
    return col * dens * spin * 2.6;
}

void main() {
    bool moving = cam.moving != 0;
    int WIDTH  = cam.renderWidth;
    int HEIGHT = cam.renderHeight;

    ivec2 pix = ivec2(gl_GlobalInvocationID.xy);
    if (pix.x >= WIDTH || pix.y >= HEIGHT) return;

    float u = (2.0 * (pix.x + 0.5 + cam.jitter.x) / WIDTH - 1.0) * cam.aspect * cam.tanHalfFov;
    float v = (1.0 - 2.0 * (pix.y + 0.5 + cam.jitter.y) / HEIGHT) * cam.tanHalfFov;
    vec3 dir = normalize(u * cam.camRight - v * cam.camUp + cam.camForward);
    Ray ray = initRay(cam.camPos, dir);

    vec4 color = vec4(0.0);
    vec3 prevPos = vec3(ray.x, ray.y, ray.z);

    bool hitBlackHole = false;
    bool hitObject    = false;
    bool escaped      = false;   // true only when the ray cleanly reaches infinity
    // Front-to-back accumulation of the (semi-transparent, emissive) disk, so the
    // lensed secondary/tertiary images — the disk wrapping over and under the
    // shadow — composite in instead of only the first crossing being shown.
    vec3  diskAccum = vec3(0.0);
    float diskTrans = 1.0;   // remaining transmittance toward the background
    int   diskHits  = 0;

    // --- Straight-line suns intersection if showBeam is disabled ---
    float tSun = 1e30;
    int hitSunIndex = -1;
    if (cam.showBeam == 0) {
        for (int i = 0; i < numObjects; ++i) {
            if (objColor[i].r == 0.0 && objColor[i].g == 0.0 && objColor[i].b == 0.0) continue;
            vec3 center = objPosRadius[i].xyz;
            float radius = objPosRadius[i].w;
            vec3 oc = cam.camPos - center;
            float b = dot(oc, dir);
            float c_coeff = dot(oc, oc) - radius * radius;
            float h = b*b - c_coeff;
            if (h >= 0.0) {
                float t = -b - sqrt(h);
                if (t > 0.0 && t < tSun) { tSun = t; hitSunIndex = i; }
            }
        }
    }

    int steps = cam.steps;
    float dLambda = cam.dLambda / U;
    float escapeR = float(ESCAPE_R) / U;
    float halfThick    = thickness * 1.5;        // SI half-height of the disk slab
    float halfThickScl = halfThick / U;          // same, in scaled (r_s) units

    for (int i = 0; i < steps; ++i) {
        if (intercept(ray)) { hitBlackHole = true; break; }
        float dL = dLambda * clamp(ray.r / 8.0, 1.0, 16.0);
        // Refine the step through the chaotic photon-sphere shell (Kerr only),
        // where tiny trajectory changes scatter rays to different destinations →
        // per-pixel speckle. The legacy/a=0 path is left untouched (already clean).
        if (useKerr() && ray.r < 4.0) dL *= 0.4;
        // Refine while approaching/inside the disk slab so a steep ray cannot step
        // over it and the volume is sampled cleanly.
        float cylR0 = length(vec2(ray.x, ray.z));
        if (cylR0 >= disk_r1 && cylR0 <= disk_r2 && abs(ray.y) < halfThick * 2.0)
            dL = min(dL, halfThickScl * 0.25);
        rk4Step(ray, dL);

        vec3 newPos = vec3(ray.x, ray.y, ray.z);
        // Volumetric disk slab (|y| < halfThick): emission-absorption accumulation,
        // giving the disk a real vertical extent and a soft edge. The ray keeps
        // going so the light looping behind the BH still crosses the slab again.
        float cylR = length(vec2(newPos.x, newPos.z));
        if (diskTrans > 0.02 && diskHits < 64 &&
            cylR >= disk_r1 && cylR <= disk_r2 && abs(newPos.y) < halfThick) {
            float dens = 1.0 - abs(newPos.y) / halfThick;            // peak at midplane
            float optd = dens * distance(prevPos, newPos) / halfThick;
            float aSeg = clamp(optd * 2.5, 0.0, 0.9);                // per-segment opacity
            diskAccum += diskTrans * aSeg * diskShade(cylR, newPos.x, newPos.z);
            diskTrans *= (1.0 - aSeg);
            ++diskHits;
            if (diskTrans < 0.02) break;                            // disk went opaque
        }

        // Polar jets: optically-thin emission accumulated along the ray (front-to-back).
        vec3 jet = jetEmission(newPos);
        if (jet.r + jet.g + jet.b > 0.0)
            diskAccum += diskTrans * jet * (distance(prevPos, newPos) / SagA_rs) * 0.45;

        if (cam.showBeam == 0 && hitSunIndex != -1) {
            float distFromCam = distance(newPos, cam.camPos);
            if (distFromCam >= tSun) {
                hitObject = true;
                objectColor = objColor[hitSunIndex];
                hitCenter = objPosRadius[hitSunIndex].xyz;
                ray.x = cam.camPos.x + tSun * dir.x;
                ray.y = cam.camPos.y + tSun * dir.y;
                ray.z = cam.camPos.z + tSun * dir.z;
                break;
            }
        }

        if (cam.showBeam != 0) {
            if (interceptObject(ray)) { hitObject = true; break; }
        } else {
            if (interceptObject(ray)) {
                if (objectColor.r == 0.0 && objectColor.g == 0.0 && objectColor.b == 0.0) {
                    hitObject = true; break;
                }
            }
        }

        prevPos = newPos;
        if (ray.dr > 0.0 && ray.r > escapeR) { escaped = true; break; }
    }

    // Background behind the accumulated disk: shadow, lensed sun, or starfield.
    vec3 bg = vec3(0.0);
    bool bgLit = false;
    if (hitBlackHole) {
        bg = vec3(0.0); bgLit = true;            // opaque shadow

    } else if (hitObject) {
        vec3 P = vec3(ray.x, ray.y, ray.z);
        vec3 N = normalize(P - hitCenter);
        vec3 V = normalize(cam.camPos - P);
        float intensity = 0.1 + 0.9 * max(dot(N, V), 0.0);
        bg = objectColor.rgb * intensity; bgLit = true;

    } else if (escaped) {
        bg = deepSky(rayCartesianDir(ray)); bgLit = true;

    } else {
        // Ran out of steps without escaping → captured, or winding near the photon
        // sphere / polar axis. Render as shadow instead of sampling a random (now
        // bright) sky direction — that was the source of the white speckle dots
        // around the shadow and along the spin axis.
        bg = vec3(0.0); bgLit = true;
    }

    vec3 rgb = diskAccum + diskTrans * bg;
    float a  = (diskHits > 0 || bgLit) ? 1.0 : 0.0;
    color = vec4(rgb, a);

    vec4 outColor = color;
    if (cam.sampleIndex > 0) {
        vec4 prev = imageLoad(accumImage, pix);
        outColor = mix(prev, color, 1.0 / float(cam.sampleIndex + 1));
    }
    imageStore(accumImage, pix, outColor);
    imageStore(outImage, pix, outColor);
}
