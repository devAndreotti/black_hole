#version 430
layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0, rgba8) writeonly uniform image2D outImage;
// Running average of jittered samples (temporal AA); valid while the view is static
layout(binding = 1, rgba32f) uniform image2D accumImage;
layout(std140, binding = 1) uniform Camera {
    vec3 camPos;     float _pad0;
    vec3 camRight;   float _pad1;
    vec3 camUp;      float _pad2;
    vec3 camForward; float _pad3;
    float tanHalfFov;
    float aspect;
    int moving;
    int renderWidth;
    int renderHeight;
    int steps;
    float dLambda;
    float kerrSpin;   // DIMENSIONLESS spin a* in [0,1]; a = a*·(r_s/2)
    vec2 jitter;      // sub-pixel ray offset (in pixels) for temporal AA
    int sampleIndex;  // 0 = fresh frame (no blend), N>0 = Nth accumulation pass
    int showBeam;
    float time;       // elapsed seconds, for Keplerian disk animation
    int diskAnim;     // 1 = animate disk material (Keplerian rotation)
    float bhTilt;     // BH symmetry-axis tilt (radians) around X; spin axis follows
} cam;

// Camera position in the BH's LOCAL frame (disk plane = y=0, spin axis = +y).
// Set in main() from the tilt; everything BH-relative (disk Doppler, jets, Kerr)
// is evaluated in this frame so a single tilt orients disk + spin + jets together.
vec3 gCamL;
// BH tilt rotation (local→world) and its inverse (world→local), set in main(). Used
// to keep the suns/moons/meteor FIXED in world when the BH tilts: their world coords
// are pulled into the local integration frame via gBhRt.
mat3 gBhR, gBhRt;

layout(std140, binding = 2) uniform Disk {
    float disk_r1;
    float disk_r2;
    float disk_num;
    float thickness;
    vec4 diskColor_tint;
};

layout(std140, binding = 3) uniform Objects {
    int numObjects;
    vec4 objPosRadius[16];
    vec4 objColor[16];
    float  mass[16];
};

const float SagA_rs = 1.269e10;     // Schwarzschild radius in SI metres
const double ESCAPE_R = 5e11;

// ── Units ────────────────────────────────────────────────────────────────────
// Integration runs in NON-DIMENSIONAL units (length in r_s, so r_s = 1). At SI
// scale r ~ 1e11 m the Kerr effective-potential terms Σ²,P² reach ~r⁴ ~ 1e44 and
// overflow float32 → NaN; in r_s units r̃ ~ 1..40 stays safe. Both the Kerr and
// the legacy Schwarzschild integrators run scaled. ray.r is SCALED; ray.x/y/z
// are kept in SI metres for the intersection tests.
const float U = SagA_rs;

vec4 objectColor = vec4(0.0);
vec3 hitCenter = vec3(0.0);

// Kerr spin in scaled units: ã = a/r_s = a*·(1/2). a=0 → Schwarzschild.
float kerrA() { return cam.kerrSpin * 0.5; }
// Default view (no spin) uses the LEGACY Schwarzschild integrator so its look is
// identical to --legacy (clean shadow, smooth photon ring). Kerr only kicks in
// once the user enables spin (K / --spin), which is an opt-in feature.
bool useKerr() { return kerrA() > 1e-6; }

// ── Coordinate convention ────────────────────────────────────────────────────
// Y-polar spherical: θ from +Y, φ in the XZ plane. Polar axis = Y, so the
// equatorial plane (θ=π/2) is the disk plane (Y=0) and the Kerr spin axis = Y.
//   x = r·sinθ·cosφ,  y = r·cosθ,  z = r·sinθ·sinφ
// ────────────────────────────────────────────────────────────────────────────

struct Ray {
    float x, y, z;    // SI Cartesian (for intersection tests)
    float r;          // SCALED radius: |cpos| (Schwarzschild) or Kerr-radius (Kerr)
    float dr;         // radial-velocity sign (for the escape test)
    float E;          // Kerr conserved energy (Kerr-Schild Hamiltonian)
    vec3  cpos, cvel; // scaled position; velocity (Schwarzschild) | covariant momentum (Kerr)
};

// Cartesian Schwarzschild null-geodesic acceleration (scaled, r_s = 1):
//   d²r⃗/dλ² = −1.5·|r⃗×v⃗|²·r⃗ / r⁵
// No spherical coordinates → no polar-axis singularity → no seam. Photon sphere
// at r=1.5, shadow impact parameter 3√3/2 — same physics as the spherical form.
vec3 cartAccel(vec3 p, vec3 v) {
    vec3 h = cross(p, v);
    float r2 = dot(p, p);
    return (-1.5 * dot(h, h) / (r2 * r2 * sqrt(r2))) * p;
}

// ── Kerr-Schild Cartesian (spin axis = Y, scaled r_s = 1) ────────────────────
// Kerr geodesics as a Hamiltonian flow in CARTESIAN coords → no spherical polar
// axis → no seam, even with spin. State = position x⃗ + covariant spatial momentum
// p⃗; energy E conserved. Metric g_μν = η_μν + f·l_μl_ν (Kerr-Schild form).
float ksRadius(vec3 P, float a) {           // Kerr radius from Cartesian (axial = y)
    float a2 = a*a;
    float t  = dot(P,P) - a2;
    return sqrt(max(0.5*(t + sqrt(t*t + 4.0*a2*P.y*P.y)), 1.0e-6));
}
vec3 ksLs(vec3 P, float r, float a) {       // spatial covariant null vector (|l|=1)
    float d = r*r + a*a;
    return vec3((r*P.x + a*P.z)/d, P.y/r, (r*P.z - a*P.x)/d);
}
float ksF(vec3 P, float r, float a) {       // Kerr-Schild scalar (r_s = 1)
    return r*r*r / (r*r*r*r + a*a*P.y*P.y);
}
// Φ(x) = f·(E + l·p)²  — the only x-dependent piece of the null Hamiltonian 2H.
float ksPhi(vec3 P, vec3 p, float E, float a) {
    float r = ksRadius(P, a);
    float q = E + dot(ksLs(P, r, a), p);
    return ksF(P, r, a) * q * q;
}
// Hamilton's equations: dx = ∂H/∂p, dp = −∂H/∂x (the x-derivative via finite diff).
void ksRHS(vec3 x, vec3 p, float E, float a, out vec3 dx, out vec3 dp) {
    float r = ksRadius(x, a);
    vec3  l = ksLs(x, r, a);
    float f = ksF(x, r, a);
    float q = E + dot(l, p);
    dx = p - f*q*l;                          // dxⁱ/dλ = gⁱᵛ pᵥ
    float e = 1.0e-3 * max(r, 1.0);          // dpᵢ/dλ = ½ ∂Φ/∂xⁱ  (central difference)
    dp = 0.5 * vec3(
        ksPhi(x+vec3(e,0,0),p,E,a) - ksPhi(x-vec3(e,0,0),p,E,a),
        ksPhi(x+vec3(0,e,0),p,E,a) - ksPhi(x-vec3(0,e,0),p,E,a),
        ksPhi(x+vec3(0,0,e),p,E,a) - ksPhi(x-vec3(0,0,e),p,E,a)) / (2.0*e);
}

// ── initRay: per-model coordinate convention, then conserved quantities ──────
// Kerr → Y-polar (spin axis = Y, physically required). Legacy/Schwarzschild →
// Both models integrate in CARTESIAN coordinates (no spherical polar axis → no
// seam): Schwarzschild via cartAccel, Kerr via the Kerr-Schild Hamiltonian flow.
Ray initRay(vec3 pos, vec3 dir) {
    Ray ray;
    ray.x = pos.x; ray.y = pos.y; ray.z = pos.z;   // SI
    float rmag = length(pos);
    ray.r = rmag / U;                               // scaled

    if (useKerr()) {
        // Kerr-Schild Cartesian init. Set p^i = dir, solve the null condition for
        // p^t, then lower to covariant p (so dx/dλ = dir exactly at the camera).
        float a = kerrA();
        vec3  cp = pos / U;
        float r0 = ksRadius(cp, a);
        vec3  l0 = ksLs(cp, r0, a);
        float f0 = ksF(cp, r0, a);
        float m  = dot(l0, dir);
        float A = f0 - 1.0, B = 2.0*f0*m, C = f0*m*m + 1.0;
        float disc = max(B*B - 4.0*A*C, 0.0);
        float pt = (-B - sqrt(disc)) / (2.0*A);
        if (pt < 0.0) pt = (-B + sqrt(disc)) / (2.0*A);   // future-directed
        ray.cpos = cp;
        ray.cvel = dir + f0*(pt+m)*l0;          // covariant spatial momentum p⃗
        ray.E    = pt - f0*(pt+m);
        ray.r    = r0;
        ray.dr   = dot(cp, dir);                // radial-velocity sign (dx≈dir at start)
    } else {
        // Legacy Schwarzschild: pure Cartesian — no spherical coords, no axis seam.
        ray.cpos = pos / U;          // scaled position
        ray.cvel = dir;              // unit direction (affine velocity)
        ray.dr   = dot(ray.cpos, ray.cvel);   // radial-velocity sign (for escape test)
    }
    return ray;
}

// Capture at the outer horizon r₊ = ½(1 + √(1−4a²)) (scaled); = 1 when a=0.
bool intercept(Ray ray) {
    float a = kerrA();
    float rh = 0.5 * (1.0 + sqrt(max(1.0 - 4.0*a*a, 0.0)));
    return ray.r <= rh;
}
bool interceptObject(Ray ray) {
    vec3 P = vec3(ray.x, ray.y, ray.z);
    for (int i = 0; i < numObjects; ++i) {
        vec3 center = gBhRt * objPosRadius[i].xyz;   // world → local (suns stay world-fixed on tilt)
        float radius = objPosRadius[i].w;
        if (distance(P, center) <= radius) {
            objectColor = objColor[i];
            hitCenter = center;
            return true;
        }
    }
    return false;
}

void rk4Step(inout Ray ray, float dL) {
    if (useKerr()) {
        // Kerr-Schild Cartesian RK4 over (position x, covariant momentum p).
        float a = kerrA(); float E = ray.E;
        vec3 x = ray.cpos, p = ray.cvel;
        vec3 dx1,dp1, dx2,dp2, dx3,dp3, dx4,dp4;
        ksRHS(x,              p,              E, a, dx1, dp1);
        ksRHS(x+0.5*dL*dx1,   p+0.5*dL*dp1,   E, a, dx2, dp2);
        ksRHS(x+0.5*dL*dx2,   p+0.5*dL*dp2,   E, a, dx3, dp3);
        ksRHS(x+dL*dx3,       p+dL*dp3,       E, a, dx4, dp4);
        vec3 dxavg = (dx1 + 2.0*dx2 + 2.0*dx3 + dx4) / 6.0;
        ray.cpos = x + dL*dxavg;
        ray.cvel = p + dL/6.0*(dp1 + 2.0*dp2 + 2.0*dp3 + dp4);
        ray.r  = ksRadius(ray.cpos, a);
        ray.dr = dot(ray.cpos, dxavg);             // radial-velocity sign
        vec3 si = ray.cpos * U;
        ray.x = si.x; ray.y = si.y; ray.z = si.z;  // SI world (KS Cartesian = world)
    } else {
        // Legacy Schwarzschild: Cartesian RK4 over (cpos, cvel). No spherical
        // coords → no axis singularity → no seam.
        vec3 p = ray.cpos, v = ray.cvel;
        vec3 k1p = v,             k1v = cartAccel(p, v);
        vec3 k2p = v+0.5*dL*k1v,  k2v = cartAccel(p+0.5*dL*k1p, v+0.5*dL*k1v);
        vec3 k3p = v+0.5*dL*k2v,  k3v = cartAccel(p+0.5*dL*k2p, v+0.5*dL*k2v);
        vec3 k4p = v+dL*k3v,      k4v = cartAccel(p+dL*k3p,     v+dL*k3v);
        ray.cpos = p + dL/6.0*(k1p + 2.0*k2p + 2.0*k3p + k4p);
        ray.cvel = v + dL/6.0*(k1v + 2.0*k2v + 2.0*k3v + k4v);
        ray.r  = length(ray.cpos);
        ray.dr = dot(ray.cpos, ray.cvel);            // radial-velocity sign
        vec3 si = ray.cpos * U;
        ray.x = si.x; ray.y = si.y; ray.z = si.z;    // SI world
    }
}
// --- Deep-sky helpers ---
float starHash(vec3 p) {
    p = fract(p * vec3(127.1, 311.7, 74.7));
    p += dot(p, p.yzx + 19.19);
    return fract(p.x * p.y * p.z * 95.13);
}
// Smooth 3D value noise + fBm for the nebula clouds.
float hash13(vec3 p) {
    p = fract(p * 0.1031);
    p += dot(p, p.zyx + 31.32);
    return fract((p.x + p.y) * p.z);
}
vec3 hash33(vec3 p) { return vec3(hash13(p), hash13(p + 7.1), hash13(p + 13.7)); }

// ACES filmic tone mapping (Narkowicz fit): compresses the HDR scene (disk/flare/
// stars go up to ~60) into [0,1] with a graceful shoulder, so highlights grade
// instead of clipping to flat white. Applied to the displayed image only.
vec3 aces(vec3 x) {
    return clamp((x*(2.51*x+0.03)) / (x*(2.43*x+0.59)+0.14), 0.0, 1.0);
}
float vnoise(vec3 p) {
    vec3 i = floor(p), f = fract(p);
    f = f * f * (3.0 - 2.0 * f);
    float n000 = hash13(i + vec3(0,0,0)), n100 = hash13(i + vec3(1,0,0));
    float n010 = hash13(i + vec3(0,1,0)), n110 = hash13(i + vec3(1,1,0));
    float n001 = hash13(i + vec3(0,0,1)), n101 = hash13(i + vec3(1,0,1));
    float n011 = hash13(i + vec3(0,1,1)), n111 = hash13(i + vec3(1,1,1));
    return mix(mix(mix(n000,n100,f.x), mix(n010,n110,f.x), f.y),
               mix(mix(n001,n101,f.x), mix(n011,n111,f.x), f.y), f.z);
}
float fbm(vec3 p) {
    float v = 0.0, a = 0.5;
    for (int i = 0; i < 4; i++) { v += a * vnoise(p); p *= 2.03; a *= 0.5; }
    return v;
}

// A distinct face-on spiral galaxy sitting in one patch of the sky. Sampled along
// the escape direction like everything else, so it lenses into an Einstein ring
// when it passes behind the BH. Cheap: rays outside its angular patch early-out.
vec3 spiralGalaxy(vec3 d) {
    const vec3 gc = normalize(vec3(-0.97, -0.219, -0.105));   // direction to its centre
    float ca = dot(d, gc);
    if (ca < 0.90) return vec3(0.0);                       // ~26° patch
    vec3 upv = normalize(cross(gc, vec3(0.0, 1.0, 0.0)));
    vec3 vpv = cross(gc, upv);
    vec3 rel = d - gc * ca;                                // ⟂ component
    vec2 q   = vec2(dot(rel, upv), dot(rel, vpv)) * 2.4;   // patch → ~unit disk
    float rho = length(q);
    float phi = atan(q.y, q.x);
    float arm  = cos(2.0*phi - 7.0*log(rho + 0.08));       // 2-arm log spiral
    float arms = smoothstep(0.05, 1.0, 0.5 + 0.5*arm);
    float disk = smoothstep(1.1, 0.04, rho) * (0.20 + 0.80*arms);
    float bulge = exp(-rho*rho*22.0);                      // bright core
    float inten = clamp(disk*1.1 + bulge*1.5, 0.0, 2.2);
    vec3 col = mix(vec3(0.45,0.58,1.0), vec3(1.0,0.92,0.72), clamp(bulge*1.4, 0.0, 1.0));
    col *= 0.80 + 0.20 * vnoise(d * 40.0);                 // dust mottling in the arms
    return col * inten * 0.7;
}

// A couple of bright, coloured distant suns fixed on the sky. Because deepSky is
// sampled along the bent escape direction, they lens into arcs / Einstein rings
// when they pass behind the BH — for free, like the spiral galaxy.
vec3 distantSuns(vec3 d) {
    vec3 c = vec3(0.0);
    vec3 dir0 = normalize(vec3( 0.62,  0.28, -0.73));   // blue-white
    vec3 dir1 = normalize(vec3(-0.78, -0.12,  0.61));   // orange
    float a0 = max(dot(d, dir0), 0.0), a1 = max(dot(d, dir1), 0.0);
    c += vec3(0.78,0.87,1.00) * (1.6*smoothstep(0.9993,0.99996,a0) + 0.22*smoothstep(0.992,1.0,a0));
    c += vec3(1.00,0.70,0.40) * (1.7*smoothstep(0.9990,0.99994,a1) + 0.25*smoothstep(0.990,1.0,a1));
    return c;
}

// Procedural deep sky sampled along the (gravitationally bent) escape direction,
// so the galactic band and nebulae lens into arcs / Einstein rings near the BH.
//   • a tilted galactic band: denser stars + a faint glow + a dark dust lane
//   • coloured nebula clouds (fBm), concentrated toward the band
//   • three octaves of stars (the original starfield)
vec3 deepSky(vec3 d) {
    // Galactic pole tilted well off the Y axis so the band crosses the view
    // diagonally (and isn't hidden edge-on in the disk plane).
    const vec3 galN = normalize(vec3(0.62, 0.42, -0.66));
    float lat  = dot(d, galN);                            // 0 = in the galactic plane
    float band = exp(-lat*lat / (2.0 * 0.22*0.22));       // soft band envelope
    float dust = exp(-lat*lat / (2.0 * 0.060*0.060));     // narrow dark dust lane

    // Nebula clouds (fBm), brighter inside the band, tinted across the sky.
    float neb  = fbm(d * 3.5 + 11.0);
    neb        = smoothstep(0.46, 0.92, neb) * (0.30 + 0.70 * band);
    float tsel = fbm(d * 1.7 + 50.0);
    vec3  nebA = vec3(0.65, 0.12, 0.70);   // magenta / violet
    vec3  nebB = vec3(0.10, 0.45, 0.78);   // blue / cyan
    vec3  nebCol = mix(nebA, nebB, smoothstep(0.30, 0.70, tsel)) * neb * 0.85;
    nebCol *= (1.0 - 0.6 * dust);

    // Diffuse galactic glow, cut by the dust lane.
    vec3 glow = vec3(0.16, 0.14, 0.20) * band * (1.0 - 0.75 * dust);

    // Stars: three octaves, denser inside the band, dimmed by the dust lane.
    vec3 stars = vec3(0.0);
    for (int i = 0; i < 3; i++) {
        float scale = float(200 + i * 300);
        vec3  cell  = floor(d * scale);
        float h     = starHash(cell);
        float thresh = 0.994 + float(i) * 0.002 - 0.0035 * band;
        if (h > thresh) {
            float bright = (h - thresh) / (1.0 - thresh);
            float hc     = starHash(cell + vec3(1.0));
            stars += mix(vec3(1.0,0.85,0.70), vec3(0.80,0.90,1.0), hc)
                     * bright * (1.0 - float(i) * 0.25);
        }
    }
    stars *= (1.0 - 0.55 * dust);

    return min(stars + nebCol + glow + spiralGalaxy(d), vec3(1.6)) + distantSuns(d);
}

// ── Colour palette ─────────────────────────────────────────────────────────────
// The scene palette (disk, jets, meteors all follow it) is stored in
// diskColor_tint.a as an integer mode. Set by --red/--white/--blue/--green or
// cycled live with F. These MUST stay in sync with cycleColorMode() in
// black_hole.cpp. Mode 0 (unset) reads as DEFAULT via the else-branches.
const int CMODE_DEFAULT = 1;   // amber/orange — the classic look
const int CMODE_RED     = 2;
const int CMODE_WHITE   = 3;
const int CMODE_BLUE    = 4;   // neutron-star / X-ray-binary blue
const int CMODE_GREEN   = 5;   // exotic / alien green
int colorMode() { return int(round(diskColor_tint.a)); }

// Emissive colour of the accretion disk at an equatorial hit point (cylindrical
// radius dhR, plane coords dhX/dhZ). Includes the radial tint, optional Keplerian
// animation, relativistic Doppler beaming, and gravitational redshift. Evaluated
// at every plane crossing so the lensed secondary image can be composited.
vec3 diskShade(float dhR, float dhX, float dhZ) {
    float r = dhR / disk_r2;
    vec3 diskColor;
    int mode = colorMode();
    if (mode == CMODE_RED) {
        diskColor = vec3(1.0 - 0.5*r, 0.1*(1.0 - r), 0.1*(1.0 - r));
    } else if (mode == CMODE_WHITE) {
        float val = 1.0 - 0.5*r;
        diskColor = vec3(val, val, val + 0.05*(1.0 - r));
    } else if (mode == CMODE_BLUE) {
        // White-hot inner → electric blue outer
        diskColor = vec3(0.7*(1.0-r)+0.1, 0.6*(1.0-r)+0.3, 1.0-r*0.1);
    } else if (mode == CMODE_GREEN) {
        diskColor = vec3(0.15*(1.0-r)+0.05, 0.5*(1.0-r)+0.5, 0.2*(1.0-r)+0.1);
    } else {
        diskColor = vec3(1.0, r, 0.2);   // default: amber, reddening outward
    }

    if (cam.diskAnim != 0) {
        float omega   = 0.5 * pow(disk_r2 / max(dhR, 1.0), 1.5);
        float matPhi  = atan(dhZ, dhX) - cam.time * omega;
        float pattern = 0.55 + 0.45 * cos(matPhi * 6.0 + r * 3.14159);
        diskColor    *= pattern;
    }

    float phi = atan(dhZ, dhX);
    // Orbiting hot spots: a few bright knots circling at the local Keplerian rate,
    // so the Doppler beaming below boosts them like the rest of the flow. Always on
    // (they animate whenever the scene re-renders) — cheap dynamism on the disk.
    float hot = 0.0;
    for (int k = 0; k < 3; k++) {
        float fk = float(k);
        float hr = mix(disk_r1 * 1.4, disk_r2 * 0.85, fract(0.37 + 0.31 * fk));
        float homega = 0.5 * pow(disk_r2 / max(hr, 1.0), 1.5);
        float da = phi - (homega * cam.time + fk * 2.39996);
        da = atan(sin(da), cos(da));                              // wrap to [-pi,pi]
        float dr = (dhR - hr) / (disk_r2 * 0.10);
        hot += exp(-(da * da) / (2.0 * 0.18 * 0.18) - dr * dr);   // gaussian knot
    }
    diskColor *= 1.0 + 1.6 * hot;
    // Accretion flicker: faint turbulent brightness variation in space and time.
    diskColor *= 0.80 + 0.35 * vnoise(vec3(phi * 3.0, r * 8.0, cam.time * 2.5));

    // Relativistic Doppler beaming (Keplerian prograde orbit)
    float beta   = clamp(sqrt(SagA_rs / (2.0 * dhR)), 0.0, 0.95);
    vec3  velDir = normalize(vec3(-dhZ, 0.0, dhX));
    vec3  viewDir = normalize(gCamL - vec3(dhX, 0.0, dhZ));
    float cosA   = dot(velDir, viewDir);
    float gamma  = 1.0 / sqrt(1.0 - beta * beta);
    float D      = 1.0 / (gamma * (1.0 - beta * cosA));
    diskColor   *= clamp(D*D*D, 0.05, 8.0);
    float shift  = clamp((D - 1.0) * 0.35, -0.3, 0.3);
    diskColor.b  = clamp(diskColor.b + shift * 0.55, 0.0, 1.0);
    diskColor.g  = clamp(diskColor.g + shift * 0.15, 0.0, 1.0);

    // Gravitational redshift (dims + reddens toward the horizon)
    float gr = sqrt(max(1.0 - SagA_rs / dhR, 0.0));
    diskColor   *= clamp(gr*gr*gr, 0.03, 1.0);
    diskColor.g *= gr;
    diskColor.b *= gr*gr;
    return diskColor;
}

// Relativistic polar jet emission at a point (SI Cartesian). Two jets along ±Y
// (the spin axis), powered by the BH spin (Blandford-Znajek) → intensity ∝ spin,
// so they only appear once Kerr spin is enabled. Optically thin, emissive.
vec3 jetEmission(vec3 pos) {
    float spin = cam.kerrSpin;
    if (spin < 0.02) return vec3(0.0);
    float ay = abs(pos.y);
    float h  = ay / SagA_rs;                          // height above the plane, in r_s
    if (h < 3.0 || h > 30.0) return vec3(0.0);        // emanate ABOVE the shadow (~2.6 r_s)
    float jetR = SagA_rs * (0.6 + 0.22 * (h - 3.0));  // wide flaring cone (a plume, not a line)
    float cylR = length(vec2(pos.x, pos.z));
    float rr = cylR / jetR;
    if (rr > 1.0) return vec3(0.0);
    float radial = exp(-rr*rr*2.5);                   // soft gaussian core, feathered edge
    float heightFade = smoothstep(3.0, 5.0, h) * smoothstep(30.0, 8.0, h);  // bright base → fade
    float flow  = (cam.diskAnim != 0) ? cam.time * 0.6 : 0.0;       // TAA-safe when off
    float ph    = atan(pos.z, pos.x);
    // two-frequency turbulence so it reads as a turbulent plume, not a hard beam
    float turb  = 0.5 + 0.3*sin(ph*3.0 - h*1.4 + flow) + 0.2*sin(ph + h*0.6 - flow*0.7);
    float dens  = radial * heightFade * max(turb, 0.0);
    // Jet colour follows the disk colour mode so it matches the scene.
    int  mode = colorMode();
    vec3 hot  = (mode == CMODE_RED)   ? vec3(1.00,0.45,0.30)   // red jet
              : (mode == CMODE_WHITE) ? vec3(0.95,0.97,1.00)   // white jet
              : (mode == CMODE_BLUE)  ? vec3(0.40,0.70,1.00)   // blue jet
              : (mode == CMODE_GREEN) ? vec3(0.40,1.00,0.55)   // green jet
                                      : vec3(1.00,0.62,0.18);  // default: amber (matches disk)
    vec3 cool = hot * vec3(0.65,0.72,0.95);             // dims toward the tip
    vec3 col  = mix(hot, cool, clamp((h-3.0)/22.0, 0.0, 1.0));
    return col * dens * spin * 1.8;
}

// Temporal variability of the "variable star" (the red sun): a gentle ripple plus
// occasional brighter outbursts (flare / mini-supernova). Returns a brightness
// factor (1.0 for the other suns); drives surface brightness AND corona size, so
// during a flare the star brightens and its halo swells.
float sunFlare(vec3 col) {
    if (col.r < 0.5 || col.g > 0.4 || col.b > 0.4) return 1.0;   // only the red star
    float t = cam.time;
    float ripple = 0.90 + 0.10 * sin(t * 2.3);                   // steady shimmer
    float env    = smoothstep(0.60, 0.97, sin(t * 0.11));        // occasional buildup
    float burst  = env * (0.5 + 0.5 * sin(t * 6.0));             // the outburst itself
    return ripple + 1.1 * burst;                                 // ~0.8 .. ~2.0x (contained)
}

// Occasional meteor: transit flyby or captured infall, with tidal spaghettification
// on capture. Color follows the disk palette (shift = mode-appropriate hue gradient).
// Tapered filament: bright tight nucleus at leading edge, needle-thin fading trail.
// Transit appears as a distant pixel and grows as it approaches — never pops abruptly.
vec3 meteorEmission(vec3 p) {
    const float CYCLE = 24.0, ACTIVE = 0.67;   // every 24s, ~16s visible (less frequent)
    const float CAPTURE_PROB = 0.32;           // ~1 in 3 meteors is swallowed (else transit)
    const float CAP_FAR      = 1.3e12;         // capture starts this far out (m): fades-in / stretches from here
    const float TAIL_FRAC    = 0.08;           // trail-tip thickness as fraction of the nucleus → needle-thin
    float ph = fract(cam.time / CYCLE);
    if (ph > ACTIVE) return vec3(0.0);
    float u    = ph / ACTIVE;
    float seed = floor(cam.time / CYCLE);
    vec3  pw   = gBhR * p;
    float rs   = SagA_rs;
    int   mode = colorMode();                   // palette follows disk colour mode

    vec3 dir = normalize(hash33(vec3(seed, 4.1, 2.5)) - 0.5);
    bool capture = hash13(vec3(seed, 3.0, 7.0)) < CAPTURE_PROB;

    vec3  head, tail, col;
    float thick, thickTail, bright, trailProx;

    if (!capture) {
        // TRANSIT: comet-like flyby. Visible from far as a point pixel, grows as it
        // approaches the BH (tidal brightening), recedes back to a faint dot.
        vec3  ref  = (abs(dir.y) > 0.9) ? vec3(1,0,0) : vec3(0,1,0);
        vec3  perp = normalize(cross(dir, ref));
        float b    = mix(1.3e11, 6.0e11, hash13(vec3(seed,2.0,1.0)));
        head = perp * b + dir * (u - 0.5) * 3.6e12;
        float prox = clamp(4.0e11 / max(length(head), 1.0), 0.0, 1.4);
        thick     = mix(1.0e8, 5.0e8, min(prox, 1.0));   // thin; swells near BH
        thickTail = thick * TAIL_FRAC;                     // tail nearly invisible
        tail      = head - dir * mix(8.0e9, 4.0e10, min(prox, 1.0));
        float env = smoothstep(0.0, 0.05, u) * smoothstep(1.0, 0.95, u);
        bright    = env;          // always visible; trail additionally scaled by prox below
        trailProx = prox;

        col = (mode==CMODE_RED)   ? vec3(1.00,0.60,0.25)   // warm orange comet
            : (mode==CMODE_WHITE) ? vec3(1.00,1.00,1.00)   // pure white
            : (mode==CMODE_BLUE)  ? vec3(0.45,0.80,1.00)   // electric cyan
            : (mode==CMODE_GREEN) ? vec3(0.45,1.00,0.50)   // lime
                                  : vec3(0.85,0.92,1.00);  // default: ice-blue comet

    } else {
        // CAPTURE: spiral infall, tidally stretched into a filament. Color shifts from
        // the disk's "far" tone toward the "near-horizon" tone as gr → 0 (frozen image).
        float r  = mix(CAP_FAR, rs*1.3, pow(u, 0.6));                   // far field → just outside horizon
        vec3  ax = normalize(hash33(vec3(seed,5.0,1.0)) - 0.5);
        vec3  ux = cross(ax, dir);
        ux = (length(ux) > 1e-3) ? normalize(ux) : normalize(cross(ax, vec3(1,0,0)));
        vec3  uy = cross(ax, ux);
        float th = 6.2832 * 2.4 * pow(u, 1.7);                          // 2.4 windings, accelerating inward
        vec3  rad = cos(th)*ux + sin(th)*uy;
        head = r * rad;
        float stretch = mix(1.5e10, 2.5e11, smoothstep(rs*9.0, rs*1.6, r));  // tidal stretch grows near BH
        tail      = head - rad * stretch;                              // spaghettified radially inward
        thick     = mix(1.5e8, 8.0e8, smoothstep(CAP_FAR, rs*4.0, r));
        thickTail = thick * TAIL_FRAC;
        float approach = smoothstep(CAP_FAR, 4.0e11, r);               // fade in from the far field
        float gr = sqrt(max(1.0 - rs*1.25 / r, 0.0));                  // grav. redshift → 0 at horizon
        bright    = approach * gr * 1.8;
        trailProx = 1.0;   // capture always shows trail

        // Shift palette: far tone → near-horizon tone as the object redshifts into black
        vec3 farCol, nearCol;
        if      (mode==CMODE_RED)  { farCol=vec3(1.0,0.70,0.35); nearCol=vec3(0.80,0.03,0.00); }  // orange→deep red
        else if (mode==CMODE_WHITE){ farCol=vec3(1.0,1.00,1.05); nearCol=vec3(0.65,0.70,0.82); }  // bright→cool grey
        else if (mode==CMODE_BLUE) { farCol=vec3(0.7,0.90,1.00); nearCol=vec3(0.05,0.12,0.75); }  // sky→deep blue
        else if (mode==CMODE_GREEN){ farCol=vec3(0.6,1.00,0.45); nearCol=vec3(0.03,0.50,0.08); }  // lime→forest
        else                       { farCol=vec3(0.9,0.95,1.00); nearCol=vec3(0.90,0.22,0.04); }  // default: ice→orange-red
        col = mix(nearCol, farCol, gr);
    }

    // Tapered segment: t=0 (tail, needle-thin) → t=1 (head, full nucleus width)
    vec3  ab   = head - tail;
    float seg  = max(dot(ab,ab), 1.0);
    float t    = clamp(dot(pw - tail, ab) / seg, 0.0, 1.0);
    float d    = distance(pw, tail + t * ab);
    float localThick = mix(thickTail, thick, t);
    float glow = exp(-d*d / (2.0*localThick*localThick)) * (0.1 + 0.9*t) * trailProx;

    // Head nucleus: wide+faint when far (visible as star-pixel), tight+bright when close
    float dHead   = distance(pw, head);
    float farFrac = 1.0 - clamp(length(head) / 1.5e12, 0.0, 1.0);  // 1=near BH, 0=far field
    float headRad = min(thick * mix(2.5, 0.25, farFrac), 1.5e9);    // capped to prevent bloom
    float headBri = mix(1.5, 8.0, farFrac);
    float headGlow = exp(-dHead*dHead / (2.0*headRad*headRad)) * headBri;

    return col * (glow + headGlow) * bright;
}

void main() {
    bool moving = cam.moving != 0;
    int WIDTH  = cam.renderWidth;
    int HEIGHT = cam.renderHeight;

    ivec2 pix = ivec2(gl_GlobalInvocationID.xy);
    if (pix.x >= WIDTH || pix.y >= HEIGHT) return;

    float u = (2.0 * (pix.x + 0.5 + cam.jitter.x) / WIDTH - 1.0) * cam.aspect * cam.tanHalfFov;
    float v = (1.0 - 2.0 * (pix.y + 0.5 + cam.jitter.y) / HEIGHT) * cam.tanHalfFov;
    vec3 dir = normalize(u * cam.camRight - v * cam.camUp + cam.camForward);

    // BH tilt: rotate the camera ray into the BH's local frame (rotation about X),
    // integrate there (disk/spin/jets are local), rotate the escape dir back to
    // world for the fixed starfield. At tilt=0 these are identity (no-op).
    float ct = cos(cam.bhTilt), st = sin(cam.bhTilt);
    gBhR  = mat3(1.0, 0.0, 0.0,   0.0, ct, st,   0.0, -st, ct);  // local → world
    gBhRt = transpose(gBhR);                                      // world → local
    gCamL = gBhRt * cam.camPos;
    dir   = gBhRt * dir;
    Ray ray = initRay(gCamL, dir);

    vec4 color = vec4(0.0);
    vec3 prevPos = vec3(ray.x, ray.y, ray.z);
    vec3 lastStepDir = dir;   // Cartesian travel dir (finite-difference, stable on the axis)

    bool hitBlackHole = false;
    bool hitObject    = false;
    bool escaped      = false;   // true only when the ray cleanly reaches infinity
    // Front-to-back accumulation of the (semi-transparent, emissive) disk, so the
    // lensed secondary/tertiary images — the disk wrapping over and under the
    // shadow — composite in instead of only the first crossing being shown.
    vec3  diskAccum = vec3(0.0);
    float diskTrans = 1.0;   // remaining transmittance toward the background
    int   diskHits  = 0;

    // --- Straight-line suns intersection if showBeam is disabled ---
    float tSun = 1e30;
    int hitSunIndex = -1;
    if (cam.showBeam == 0) {
        for (int i = 0; i < numObjects; ++i) {
            if (objColor[i].r == 0.0 && objColor[i].g == 0.0 && objColor[i].b == 0.0) continue;
            vec3 center = gBhRt * objPosRadius[i].xyz;
            float radius = objPosRadius[i].w;
            vec3 oc = gCamL - center;
            float b = dot(oc, dir);
            float c_coeff = dot(oc, oc) - radius * radius;
            float h = b*b - c_coeff;
            if (h >= 0.0) {
                float t = -b - sqrt(h);
                if (t > 0.0 && t < tSun) { tSun = t; hitSunIndex = i; }
            }
        }
    }

    int steps = cam.steps;
    float dLambda = cam.dLambda / U;
    float escapeR = float(ESCAPE_R) / U;
    float halfThick    = thickness * 1.5;        // SI half-height of the disk slab
    float halfThickScl = halfThick / U;          // same, in scaled (r_s) units

    for (int i = 0; i < steps; ++i) {
        if (intercept(ray)) { hitBlackHole = true; break; }
        float dL = dLambda * clamp(ray.r / 8.0, 1.0, 16.0);
        // Refine the step through the chaotic photon-sphere shell (Kerr only),
        // where tiny trajectory changes scatter rays to different destinations →
        // per-pixel speckle. The legacy/a=0 path is left untouched (already clean).
        if (useKerr() && ray.r < 4.0) dL *= 0.4;
        // Refine while approaching/inside the disk slab so a steep ray cannot step
        // over it and the volume is sampled cleanly.
        float cylR0 = length(vec2(ray.x, ray.z));
        if (cylR0 >= disk_r1 && cylR0 <= disk_r2 && abs(ray.y) < halfThick * 2.0)
            dL = min(dL, halfThickScl * 0.25);
        rk4Step(ray, dL);

        vec3 newPos = vec3(ray.x, ray.y, ray.z);
        // Volumetric disk slab (|y| < halfThick): emission-absorption accumulation,
        // giving the disk a real vertical extent and a soft edge. The ray keeps
        // going so the light looping behind the BH still crosses the slab again.
        float cylR = length(vec2(newPos.x, newPos.z));
        if (diskTrans > 0.02 && diskHits < 64 &&
            cylR >= disk_r1 && cylR <= disk_r2 && abs(newPos.y) < halfThick) {
            float dens = 1.0 - abs(newPos.y) / halfThick;            // peak at midplane
            float optd = dens * distance(prevPos, newPos) / halfThick;
            float aSeg = clamp(optd * 2.5, 0.0, 0.9);                // per-segment opacity
            diskAccum += diskTrans * aSeg * diskShade(cylR, newPos.x, newPos.z);
            diskTrans *= (1.0 - aSeg);
            ++diskHits;
            if (diskTrans < 0.02) break;                            // disk went opaque
        }

        // Polar jets: optically-thin emission accumulated along the ray (front-to-back).
        vec3 jet = jetEmission(newPos);
        if (jet.r + jet.g + jet.b > 0.0)
            diskAccum += diskTrans * jet * (distance(prevPos, newPos) / SagA_rs) * 0.45;

        // Coronae: soft, optically-thin halo glow accumulated as the ray passes
        // NEAR a sun (without hitting it). Pulses with time; the variable star's
        // corona brightens and swells during a flare. The ray-tracer-correct way to
        // get a glowing halo that lenses with the geodesic like everything else.
        if (diskTrans > 0.02) {
            for (int s = 0; s < numObjects; ++s) {
                vec3 scol = objColor[s].rgb;
                if (max(scol.r, max(scol.g, scol.b)) < 0.7) continue;   // skip BH + dim moons
                vec3  sc = gBhRt * objPosRadius[s].xyz; float sr = objPosRadius[s].w;
                float fl = sunFlare(scol);
                float coronaR = sr * (2.4 + 0.5 * (fl - 1.0));          // gentle swell (no engulfing)
                float d = distance(newPos, sc);
                if (d > sr && d < coronaR) {
                    float t01  = 1.0 - (d - sr) / (coronaR - sr);       // 1 at surface→0
                    float dens = t01 * t01 * t01;                       // softer outer edge
                    float puls = 0.7 + 0.3 * sin(cam.time * 0.9 + float(s) * 2.1);
                    diskAccum += diskTrans * scol * dens * puls * (0.6 + 0.4 * fl)
                               * (distance(prevPos, newPos) / sr) * 0.5;
                }
            }
        }

        // Occasional meteor streak (optically-thin, lenses near the BH).
        vec3 met = meteorEmission(newPos);
        if (met.r + met.g + met.b > 0.0)
            diskAccum += diskTrans * met * (distance(prevPos, newPos) / SagA_rs) * 0.9;

        if (cam.showBeam == 0 && hitSunIndex != -1) {
            float distFromCam = distance(newPos, gCamL);
            if (distFromCam >= tSun) {
                hitObject = true;
                objectColor = objColor[hitSunIndex];
                hitCenter = gBhRt * objPosRadius[hitSunIndex].xyz;
                ray.x = gCamL.x + tSun * dir.x;
                ray.y = gCamL.y + tSun * dir.y;
                ray.z = gCamL.z + tSun * dir.z;
                break;
            }
        }

        if (cam.showBeam != 0) {
            if (interceptObject(ray)) { hitObject = true; break; }
        } else {
            if (interceptObject(ray)) {
                if (objectColor.r == 0.0 && objectColor.g == 0.0 && objectColor.b == 0.0) {
                    hitObject = true; break;
                }
            }
        }

        lastStepDir = normalize(newPos - prevPos);   // stable escape direction
        prevPos = newPos;
        if (ray.dr > 0.0 && ray.r > escapeR) { escaped = true; break; }
    }

    // Background behind the accumulated disk: shadow, lensed sun, or starfield.
    vec3 bg = vec3(0.0);
    bool bgLit = false;
    if (hitBlackHole) {
        bg = vec3(0.0); bgLit = true;            // opaque shadow

    } else if (hitObject) {
        vec3 P = vec3(ray.x, ray.y, ray.z);
        vec3 N = normalize(P - hitCenter);
        vec3 V = normalize(gCamL - P);
        float mu = max(dot(N, V), 0.0);                       // cos(view angle)
        float limb = 0.40 + 0.60 * pow(mu, 0.55);             // solar limb darkening
        vec3  seed = N * 6.0 + hitCenter * 1e-11;             // surface coords + per-sun offset
        float gran = fbm(seed * 1.8 + cam.time * 0.05);       // boiling granulation
        float spots = fbm(seed * 0.7 + 13.0);                 // low-freq starspots
        float surf = limb * (0.78 + 0.36 * gran)
                          * mix(0.50, 1.0, smoothstep(0.34, 0.50, spots));   // darken spots
        vec3 col = objectColor.rgb * surf * sunFlare(objectColor.rgb);
        col = mix(col, col + vec3(0.45), 0.22 * pow(mu, 5.0));  // hot, whiter core
        bg = col; bgLit = true;

    } else if (escaped || ray.r > 6.0) {
        // Escaped, OR ran out of steps already out in the weak field (its direction
        // is settled) — sample the sky. Using the finite-difference travel direction
        // avoids the polar-axis singularity of the analytic reconstruction (which
        // drew a bright seam line up the spin axis). The r>6 clause also stops the
        // big black disk that appeared when zoomed far out.
        bg = deepSky(gBhR * lastStepDir); bgLit = true;

    } else {
        // Still deep in the field (r ≤ 6) and not escaping → captured or winding at
        // the photon sphere. Render as shadow, not a random bright sky sample.
        bg = vec3(0.0); bgLit = true;
    }

    vec3 rgb = diskAccum + diskTrans * bg;
    // Guard against any NaN/Inf from the Kerr integration (e.g. a ray skimming the
    // horizon) — otherwise it reads back as a transparent pixel in wallpaper mode.
    if (any(isnan(rgb)) || any(isinf(rgb))) rgb = vec3(0.0);
    rgb = min(rgb, vec3(60.0));   // Inf-safe finite clamp (survives fast-math)
    color = vec4(rgb, 1.0);       // every ray resolves to disk/shadow/object/sky → opaque

    vec4 outColor = color;
    if (cam.sampleIndex > 0) {
        vec4 prev = imageLoad(accumImage, pix);
        outColor = mix(prev, color, 1.0 / float(cam.sampleIndex + 1));
    }
    imageStore(accumImage, pix, outColor);                          // linear (TAA accumulation)
    imageStore(outImage, pix, vec4(aces(outColor.rgb * 0.65), 1.0));// exposed + tone-mapped for display
}
