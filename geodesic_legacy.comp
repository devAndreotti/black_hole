#version 430
layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0, rgba8) writeonly uniform image2D outImage;
// Running average of jittered samples (temporal AA); valid while the view is static
layout(binding = 1, rgba32f) uniform image2D accumImage;
layout(std140, binding = 1) uniform Camera {
    vec3 camPos;     float _pad0;
    vec3 camRight;   float _pad1;
    vec3 camUp;      float _pad2;
    vec3 camForward; float _pad3;
    float tanHalfFov;
    float aspect;
    int moving;
    int renderWidth;
    int renderHeight;
    int steps;
    float dLambda;
    float _pad4;
    vec2 jitter;      // sub-pixel ray offset (in pixels) for temporal AA
    int sampleIndex;  // 0 = fresh frame (no blend), N>0 = Nth accumulation pass
    int showBeam;
} cam;

layout(std140, binding = 2) uniform Disk {
    float disk_r1;
    float disk_r2;
    float disk_num;
    float thickness;
    vec4 diskColor_tint;
};

layout(std140, binding = 3) uniform Objects {
    int numObjects;
    vec4 objPosRadius[16];
    vec4 objColor[16];
    float  mass[16]; 
};

const float SagA_rs = 1.269e10;
// Just past the farthest visible content (objects at ~4.4e11). Rays that are
// already heading outward beyond this can never curve back, so we stop them.
// The old 1e30 never triggered, so every background ray burned all 768 steps.
const double ESCAPE_R = 5e11;

// Globals to store hit info
vec4 objectColor = vec4(0.0);
vec3 hitCenter = vec3(0.0);
float hitRadius = 0.0;
float diskHitR  = 0.0; // cylindrical radius at exact disk-plane crossing
float diskHitX  = 0.0;
float diskHitZ  = 0.0;

struct Ray {
    float x, y, z, r, theta, phi;
    float dr, dtheta, dphi;
    float E, L;
};
Ray initRay(vec3 pos, vec3 dir) {
    Ray ray;
    ray.x = pos.x; ray.y = pos.y; ray.z = pos.z;
    ray.r = length(pos);
    ray.theta = acos(pos.z / ray.r);
    ray.phi = atan(pos.y, pos.x);

    float dx = dir.x, dy = dir.y, dz = dir.z;
    ray.dr     = sin(ray.theta)*cos(ray.phi)*dx + sin(ray.theta)*sin(ray.phi)*dy + cos(ray.theta)*dz;
    ray.dtheta = (cos(ray.theta)*cos(ray.phi)*dx + cos(ray.theta)*sin(ray.phi)*dy - sin(ray.theta)*dz) / ray.r;
    ray.dphi   = (-sin(ray.phi)*dx + cos(ray.phi)*dy) / (ray.r * sin(ray.theta));

    ray.L = ray.r * ray.r * sin(ray.theta) * ray.dphi;
    float f = 1.0 - SagA_rs / ray.r;
    float dt_dL = sqrt((ray.dr*ray.dr)/f + ray.r*ray.r*(ray.dtheta*ray.dtheta + sin(ray.theta)*sin(ray.theta)*ray.dphi*ray.dphi));
    ray.E = f * dt_dL;

    return ray;
}

bool intercept(Ray ray, float rs) {
    return ray.r <= rs;
}
// Returns true on hit, captures center, radius, and base color
bool interceptObject(Ray ray) {
    vec3 P = vec3(ray.x, ray.y, ray.z);
    for (int i = 0; i < numObjects; ++i) {
        vec3 center = objPosRadius[i].xyz;
        float radius = objPosRadius[i].w;
        if (distance(P, center) <= radius) {
            objectColor = objColor[i];
            hitCenter = center;
            hitRadius = radius;
            return true;
        }
    }
    return false;
}

void geodesicRHS(Ray ray, out vec3 d1, out vec3 d2) {
    float r = ray.r, theta = ray.theta;
    float dr = ray.dr, dtheta = ray.dtheta, dphi = ray.dphi;
    float f = 1.0 - SagA_rs / r;
    float dt_dL = ray.E / f;

    d1 = vec3(dr, dtheta, dphi);
    d2.x = - (SagA_rs / (2.0 * r*r)) * f * dt_dL * dt_dL
         + (SagA_rs / (2.0 * r*r * f)) * dr * dr
         + r * (dtheta*dtheta + sin(theta)*sin(theta)*dphi*dphi);
    d2.y = -2.0*dr*dtheta/r + sin(theta)*cos(theta)*dphi*dphi;
    d2.z = -2.0*dr*dphi/r - 2.0*cos(theta)/(sin(theta)) * dtheta * dphi;
}
void rk4Step(inout Ray ray, float dL) {
    vec3 k1a, k1b, k2a, k2b, k3a, k3b, k4a, k4b;
    Ray tmp;

    geodesicRHS(ray, k1a, k1b);

    tmp = ray;
    tmp.r      += 0.5*dL*k1a.x; tmp.dr     += 0.5*dL*k1b.x;
    tmp.theta  += 0.5*dL*k1a.y; tmp.dtheta += 0.5*dL*k1b.y;
    tmp.phi    += 0.5*dL*k1a.z; tmp.dphi   += 0.5*dL*k1b.z;
    geodesicRHS(tmp, k2a, k2b);

    tmp = ray;
    tmp.r      += 0.5*dL*k2a.x; tmp.dr     += 0.5*dL*k2b.x;
    tmp.theta  += 0.5*dL*k2a.y; tmp.dtheta += 0.5*dL*k2b.y;
    tmp.phi    += 0.5*dL*k2a.z; tmp.dphi   += 0.5*dL*k2b.z;
    geodesicRHS(tmp, k3a, k3b);

    tmp = ray;
    tmp.r      += dL*k3a.x; tmp.dr     += dL*k3b.x;
    tmp.theta  += dL*k3a.y; tmp.dtheta += dL*k3b.y;
    tmp.phi    += dL*k3a.z; tmp.dphi   += dL*k3b.z;
    geodesicRHS(tmp, k4a, k4b);

    ray.r      += dL/6.0 * (k1a.x + 2.0*k2a.x + 2.0*k3a.x + k4a.x);
    ray.theta  += dL/6.0 * (k1a.y + 2.0*k2a.y + 2.0*k3a.y + k4a.y);
    ray.phi    += dL/6.0 * (k1a.z + 2.0*k2a.z + 2.0*k3a.z + k4a.z);
    ray.dr     += dL/6.0 * (k1b.x + 2.0*k2b.x + 2.0*k3b.x + k4b.x);
    ray.dtheta += dL/6.0 * (k1b.y + 2.0*k2b.y + 2.0*k3b.y + k4b.y);
    ray.dphi   += dL/6.0 * (k1b.z + 2.0*k2b.z + 2.0*k3b.z + k4b.z);

    ray.x = ray.r * sin(ray.theta) * cos(ray.phi);
    ray.y = ray.r * sin(ray.theta) * sin(ray.phi);
    ray.z = ray.r * cos(ray.theta);
}
bool crossesEquatorialPlane(vec3 oldPos, vec3 newPos) {
    if (oldPos.y * newPos.y >= 0.0) return false;
    float t = oldPos.y / (oldPos.y - newPos.y);
    vec3 hit = mix(oldPos, newPos, t);
    float r = length(vec2(hit.x, hit.z));
    if (r >= disk_r1 && r <= disk_r2) { diskHitR = r; diskHitX = hit.x; diskHitZ = hit.z; return true; }
    return false;
}

// --- Starfield helpers ---
float starHash(vec3 p) {
    p = fract(p * vec3(127.1, 311.7, 74.7));
    p += dot(p, p.yzx + 19.19);
    return fract(p.x * p.y * p.z * 95.13);
}
// Procedural gravitationally-lensed starfield sampled along escaped ray direction.
// Three octaves: bright/rare → medium → faint/common.
vec3 starfield(vec3 d) {
    vec3 col = vec3(0.0);
    for (int i = 0; i < 3; i++) {
        float scale = float(200 + i * 300);
        vec3 cell   = floor(d * scale);
        float h     = starHash(cell);
        float thresh = 0.994 + float(i) * 0.002;
        if (h > thresh) {
            float bright  = (h - thresh) / (1.0 - thresh);
            float hc      = starHash(cell + vec3(1.0));
            vec3 starCol  = mix(vec3(1.0, 0.85, 0.70), vec3(0.80, 0.90, 1.0), hc);
            col += starCol * bright * (1.0 - float(i) * 0.25);
        }
    }
    return min(col, vec3(1.0));
}
// True Cartesian velocity direction of the ray at its current spherical state.
// Used to sample the lensed starfield along the actual bent ray path.
vec3 rayCartesianDir(Ray ray) {
    float st = sin(ray.theta), ct = cos(ray.theta);
    float sp = sin(ray.phi),   cp = cos(ray.phi);
    return normalize(vec3(
        ray.dr * st*cp + ray.r * ray.dtheta * ct*cp - ray.r * st * ray.dphi * sp,
        ray.dr * st*sp + ray.r * ray.dtheta * ct*sp + ray.r * st * ray.dphi * cp,
        ray.dr * ct    - ray.r * ray.dtheta * st
    ));
}

void main() {
    bool moving = cam.moving != 0;
    int WIDTH  = cam.renderWidth;
    int HEIGHT = cam.renderHeight;

    ivec2 pix = ivec2(gl_GlobalInvocationID.xy);
    if (pix.x >= WIDTH || pix.y >= HEIGHT) return;

    // Init Ray
    float u = (2.0 * (pix.x + 0.5 + cam.jitter.x) / WIDTH - 1.0) * cam.aspect * cam.tanHalfFov;
    float v = (1.0 - 2.0 * (pix.y + 0.5 + cam.jitter.y) / HEIGHT) * cam.tanHalfFov;
    vec3 dir = normalize(u * cam.camRight - v * cam.camUp + cam.camForward);
    Ray ray = initRay(cam.camPos, dir);

    vec4 color = vec4(0.0);
    vec3 prevPos = vec3(ray.x, ray.y, ray.z);
    float lambda = 0.0;

    bool hitBlackHole = false;
    bool hitDisk      = false;
    bool hitObject    = false;

    // --- Straight-line suns intersection if showBeam is disabled ---
    float tSun = 1e30;
    int hitSunIndex = -1;
    if (cam.showBeam == 0) {
        for (int i = 0; i < numObjects; ++i) {
            // Check if this object is a sun (non-black color)
            if (objColor[i].r == 0.0 && objColor[i].g == 0.0 && objColor[i].b == 0.0) {
                continue; // Skip the black hole itself
            }
            vec3 center = objPosRadius[i].xyz;
            float radius = objPosRadius[i].w;
            vec3 oc = cam.camPos - center;
            float b = dot(oc, dir);
            float c_coeff = dot(oc, oc) - radius * radius;
            float h = b*b - c_coeff;
            if (h >= 0.0) {
                float t = -b - sqrt(h);
                if (t > 0.0 && t < tSun) {
                    tSun = t;
                    hitSunIndex = i;
                }
            }
        }
    }

    int steps = cam.steps;
    float dLambda = cam.dLambda;

    for (int i = 0; i < steps; ++i) {
        if (intercept(ray, SagA_rs)) { hitBlackHole = true; break; }
        // Adaptive step: full fidelity inside ~8 r_s (disk + strong lensing live
        // there), growing linearly with r outside so far rays cover the same
        // distance in far fewer steps. The suns (~4.4e11, radius 4e10) still get
        // ~27 samples across their diameter at the largest in-scene step.
        float dL = dLambda * clamp(ray.r / (8.0 * SagA_rs), 1.0, 16.0);
        rk4Step(ray, dL);
        lambda += dL;

        vec3 newPos = vec3(ray.x, ray.y, ray.z);
        if (crossesEquatorialPlane(prevPos, newPos)) { hitDisk = true; break; }

        // If showBeam is disabled and we hit a sun in straight-line, check if we reached the hit distance
        if (cam.showBeam == 0 && hitSunIndex != -1) {
            float distFromCam = distance(newPos, cam.camPos);
            if (distFromCam >= tSun) {
                hitObject = true;
                objectColor = objColor[hitSunIndex];
                hitCenter = objPosRadius[hitSunIndex].xyz;
                hitRadius = objPosRadius[hitSunIndex].w;
                // Move ray position to the exact hit position for shading/normals
                ray.x = cam.camPos.x + tSun * dir.x;
                ray.y = cam.camPos.y + tSun * dir.y;
                ray.z = cam.camPos.z + tSun * dir.z;
                break;
            }
        }

        if (cam.showBeam != 0) {
            if (interceptObject(ray)) { hitObject = true; break; }
        } else {
            // Only check curved intersection for the black hole (black color)
            if (interceptObject(ray)) {
                if (objectColor.r == 0.0 && objectColor.g == 0.0 && objectColor.b == 0.0) {
                    hitObject = true;
                    break;
                }
            }
        }

        prevPos = newPos;
        // Directional escape: only bail on rays moving outward (dr > 0) past all
        // content. Inward rays (e.g. when the camera is zoomed out past ESCAPE_R)
        // keep integrating, so this is safe at every zoom level.
        if (ray.dr > 0.0 && ray.r > float(ESCAPE_R)) break;
    }

    if (hitDisk) {
        double r = double(diskHitR) / disk_r2;
        vec3 diskColor;
        int mode = int(round(diskColor_tint.a));
        if (mode == 2) {
            float redVal = 1.0f - 0.5f * float(r);
            float gbVal = 0.1f * (1.0f - float(r));
            diskColor = vec3(redVal, gbVal, gbVal);
        } else if (mode == 3) {
            float val = 1.0f - 0.5f * float(r);
            diskColor = vec3(val, val, val + 0.05f * (1.0f - float(r)));
        } else {
            diskColor = vec3(1.0f, float(r), 0.2f);
        }

        // Relativistic Doppler beaming: Keplerian prograde orbit (CCW from +y)
        float beta   = clamp(sqrt(SagA_rs / (2.0 * diskHitR)), 0.0, 0.95);
        vec3  velDir = normalize(vec3(-diskHitZ, 0.0, diskHitX));
        vec3  viewDir = normalize(cam.camPos - vec3(diskHitX, 0.0, diskHitZ));
        float cosA   = dot(velDir, viewDir);
        float gamma  = 1.0 / sqrt(1.0 - beta * beta);
        float D      = 1.0 / (gamma * (1.0 - beta * cosA));
        float D3     = clamp(D * D * D, 0.05, 8.0);
        diskColor   *= D3;
        // Color temperature shift: approaching side bluer, receding side redder
        float shift  = clamp((D - 1.0) * 0.35, -0.3, 0.3);
        diskColor.r  = clamp(diskColor.r * (1.0 - shift * 0.35), 0.0, 1.0);
        diskColor.b  = clamp(diskColor.b + shift * 0.4,           0.0, 1.0);

        color = vec4(diskColor, float(r));

    } else if (hitBlackHole) {
        color = vec4(0.0, 0.0, 0.0, 1.0);

    } else if (hitObject) {
        // Compute shading
        vec3 P = vec3(ray.x, ray.y, ray.z);
        vec3 N = normalize(P - hitCenter);
        vec3 V = normalize(cam.camPos - P);
        float ambient = 0.1;
        float diff = max(dot(N, V), 0.0);
        float intensity = ambient + (1.0 - ambient) * diff;
        vec3 shaded = objectColor.rgb * intensity;
        color = vec4(shaded, objectColor.a);

    } else {
        // Lensed starfield: sample along the actual bent ray direction at escape
        vec3 escDir = rayCartesianDir(ray);
        vec3 stars  = starfield(escDir);
        color = vec4(stars, float(length(stars) > 0.0));
    }

    // Temporal AA: blend this jittered sample into the running average.
    // sampleIndex 0 (camera moved / scene changed) starts a fresh history.
    vec4 outColor = color;
    if (cam.sampleIndex > 0) {
        vec4 prev = imageLoad(accumImage, pix);
        outColor = mix(prev, color, 1.0 / float(cam.sampleIndex + 1));
    }
    imageStore(accumImage, pix, outColor);
    imageStore(outImage, pix, outColor);
}
